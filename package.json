{
  "name": "connectsphere",
  "private": true,
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "setup": "node scripts/run.mjs setup",
    "start": "node scripts/run.mjs dev",
    "doctor": "node scripts/run.mjs doctor",
    "verify": "node scripts/run.mjs verify",
    "integration": "node scripts/run.mjs integration",
    "stop": "node scripts/run.mjs stop",
    "browser:install": "node scripts/run.mjs browser-install",
    "check:e2e": "node scripts/run.mjs e2e",
    "budget": "node scripts/run.mjs budget",
    "package:source": "node scripts/run.mjs package-source",
    "dev": "pnpm --dir frontend dev",
    "build": "pnpm --dir frontend build",
    "test": "pnpm --dir frontend test",
    "typecheck": "pnpm --dir frontend typecheck",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "supabase": "^2.39.2"
  }
}
