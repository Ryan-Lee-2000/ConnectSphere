# npm run setup writes LOCAL .env and frontend/.env.local.
# Hosted values are configured in the host, never committed.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:54322/postgres
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Seed only; never needed by the runtime application.
SUPABASE_SERVICE_ROLE_KEY=

# SPL-125 notice emails. The app refuses to start without these (tests always use the log).
# Local: smtp sends to Supabase's Mailpit (http://127.0.0.1:54324); npm run setup fills these in.
# Render: gmail_api, with the Gmail values below set in the Render environment, never in Git.
EMAIL_BACKEND=smtp
# One shared address is both the sender and the inbox.
NOTIFICATION_EMAIL_TO=connectsphere.notices@gmail.com
APP_BASE_URL=http://127.0.0.1:5173
# Optional for smtp; these are the local Mailpit defaults.
# SMTP_HOST=127.0.0.1
# SMTP_PORT=54325
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Keep disabled until SPL-129/130/137/138 and notification integration are reviewed.
EXACT_VENUE_TIMING_ENABLED=false
